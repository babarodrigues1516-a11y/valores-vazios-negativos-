    alignItems: 'center',
    backgroundColor: '#fff',
    marginHorizontal: 2,
    borderRadius: 8,
  },
  botaoSeletorAtivo: {
    backgroundColor: '#0284c7',
  },
  textoSeletor: {
    fontSize: 13,
    color: '#0284c7',
    fontWeight: 'bold',
    textAlign: 'center',
  },
  textoSeletorAtivo: {
    color: '#fff',
  },
  input: {
