import React, { useState } from 'react';
import { StyleSheet, Text, View, TextInput, TouchableOpacity, Alert, ScrollView } from 'react-native';

export default function App() {
  const [nome, setNome] = useState('');
  const [nota1, setNota1] = useState('');
  const [nota2, setNota2] = useState('');
  const [nota3, setNota3] = useState('');
  const [resultado, setResultado] = useState(null);

  const calcularMedia = () => {
    // Limpar resultado anterior
    setResultado(null);

    // Validar se o nome foi preenchido
    if (!nome.trim()) {
      Alert.alert('Erro', 'Por favor, introduza o nome do estudante.');
      return;
    }

    // Validar se todos os campos de notas estão preenchidos
    if (!nota1.trim() || !nota2.trim() || !nota3.trim()) {
      Alert.alert('Erro', 'Por favor, preencha todas as três notas.');
      return;
    }

    // Converter para número (substituindo vírgula por ponto)
    const n1 = parseFloat(nota1.replace(',', '.'));
    const n2 = parseFloat(nota2.replace(',', '.'));
    const n3 = parseFloat(nota3.replace(',', '.'));

    // Validar se são números válidos e estão entre 0 e 10
    if (isNaN(n1) || isNaN(n2) || isNaN(n3)) {
      Alert.alert('Erro', 'Introduza apenas valores numéricos válidos nas notas.');
      return;
    }

    if (n1 < 0 || n1 > 10 || n2 < 0 || n2 > 10 || n3 < 0 || n3 > 10) {
      Alert.alert('Erro', 'As notas devem estar obrigatoriamente compreendidas entre 0 e 10.');
      return;
    }

    // Calcular média aritmética
    const media = (n1 + n2 + n3) / 3;

    // Determinar situação (Aprovado se média >= 7.0)
    const situacao = media >= 7.0 ? 'Aprovado' : 'Reprovado';

    // Guardar o resultado para exibir no ecrã
    setResultado({
      nome: nome.trim(),
      media: media.toFixed(1),
      situacao: situacao,
    });
  };

  return (
    <ScrollView contentContainerStyle={styles.container}>
      <Text style={styles.titulo}>Calculadora de Média Académica</Text>

      <Text style={styles.label}>Nome do Estudante:</Text>
      <TextInput
        style={styles.input}
        placeholder="Ex: João Silva"
        value={nome}
        onChangeText={setNome}
      />

      <Text style={styles.label}>Nota 1 (0 a 10):</Text>
      <TextInput
        style={styles.input}
        placeholder="Ex: 8.0"
        keyboardType="numeric"
        value={nota1}
        onChangeText={setNota1}
      />

      <Text style={styles.label}>Nota 2 (0 a 10):</Text>
      <TextInput
        style={styles.input}
        placeholder="Ex: 7.0"
        keyboardType="numeric"
        value={nota2}
        onChangeText={setNota2}
      />

      <Text style={styles.label}>Nota 3 (0 a 10):</Text>
      <TextInput
        style={styles.input}
        placeholder="Ex: 9.0"
        keyboardType="numeric"
        value={nota3}
        onChangeText={setNota3}
      />

      <TouchableOpacity style={styles.botao} onPress={calcularMedia}>
        <Text style={styles.textoBotao}>Calcular média</Text>
      </TouchableOpacity>

      {resultado !== null && (
        <View style={styles.resultadoContainer}>
          <Text style={styles.textoResultado}>Estudante: <Text style={styles.valorNegrito}>{resultado.nome}</Text></Text>
          <Text style={styles.textoResultado}>Média: <Text style={styles.valorNegrito}>{resultado.media.replace('.', ',')}</Text></Text>
          <Text style={styles.textoResultado}>Situação: <Text style={[styles.valorNegrito, resultado.situacao === 'Aprovado' ? styles.aprovado : styles.reprovado]}>{resultado.situacao}</Text></Text>
        </View>
      )}
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  container: {
    flexGrow: 1,
    justifyContent: 'center',
    padding: 20,
    backgroundColor: '#f5f5f5',
  },
  titulo: {
    fontSize: 22,
    fontWeight: 'bold',
    textAlign: 'center',
    marginBottom: 20,
    color: '#333',
  },
  label: {
    fontSize: 16,
    marginBottom: 5,
    color: '#333',
  },
  input: {
    borderWidth: 1,
    borderColor: '#ccc',
    borderRadius: 8,
    padding: 10,
    fontSize: 16,
    backgroundColor: '#fff',
    marginBottom: 15,
  },
  botao: {
    backgroundColor: '#0284c7',
    padding: 15,
    borderRadius: 8,
    alignItems: 'center',
    marginTop: 10,
  },
  textoBotao: {
    color: '#fff',
    fontSize: 16,
    fontWeight: 'bold',
  },
  resultadoContainer: {
    marginTop: 25,
    padding: 15,
    backgroundColor: '#e0f2fe',
    borderRadius: 8,
  },
  textoResultado: {
    fontSize: 16,
    color: '#0369a1',
    marginBottom: 5,
  },
  valorNegrito: {
    fontWeight: 'bold',
  },
  aprovado: {
    color: '#16a34a',
  },
  reprovado: {
    color: '#dc2626',
  },
});
