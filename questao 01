import React, { useState } from 'react';
import { View, Text, TextInput, TouchableOpacity, StyleSheet, Alert } from 'react-native';

export default function App() {
  const [peso, setPeso] = useState('');
  const [resultado, setResultado] = useState(null);

  const calcularAgua = () => {
    const pesoNumerico = parseFloat(peso.replace(',', '.'));

    if (!peso.trim() || isNaN(pesoNumerico) || pesoNumerico <= 0) {
      Alert.alert('Atenção', 'Por favor, informe um peso válido maior que zero.');
      setResultado(null);
      return;
    }

    const litros = (pesoNumerico * 35) / 1000;
    setResultado(litros.toFixed(2).replace('.', ','));
  };

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Hidratação Diária</Text>

      <TextInput
        style={styles.input}
        placeholder="Digite seu peso em kg (ex: 70)"
        keyboardType="numeric"
        value={peso}
        onChangeText={setPeso}
      />

      <TouchableOpacity style={styles.botao} onPress={calcularAgua}>
        <Text style={styles.textoBotao}>Calcular</Text>
      </TouchableOpacity>

      {resultado && (
        <Text style={styles.resultado}>
          Consumo recomendado: {resultado} litros por dia
        </Text>
      )}
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, justifyContent: 'center', padding: 24, backgroundColor: '#f5f7fa' },
  titulo: { fontSize: 22, fontWeight: 'bold', marginBottom: 20, textAlign: 'center' },
  input: { backgroundColor: '#fff', borderWidth: 1, borderColor: '#ccc', borderRadius: 8, padding: 12, marginBottom: 16, fontSize: 16 },
  botao: { backgroundColor: '#0077b6', padding: 14, borderRadius: 8, alignItems: 'center' },
  textoBotao: { color: '#fff', fontSize: 16, fontWeight: 'bold' },
  resultado: { marginTop: 24, fontSize: 18, textAlign: 'center', fontWeight: '600', color: '#023e8a' },
});
