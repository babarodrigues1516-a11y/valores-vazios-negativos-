import React, { useState } from 'react';
import { StyleSheet, Text, View, TouchableOpacity, Alert, ScrollView } from 'react-native';

export default function App() {
  const [votosCandidato1, setVotosCandidato1] = useState(0);
  const [votosCandidato2, setVotosCandidato2] = useState(0);
  const [votosCandidato3, setVotosCandidato3] = useState(0);

  const votarCandidato1 = () => {
    setVotosCandidato1(votosCandidato1 + 1);
  };
  const votarCandidato2 = () => {
    setVotosCandidato2(votosCandidato2 + 1);
  };
  const votarCandidato3 = () => {
    setVotosCandidato3(votosCandidato3 + 1);
  };

  const totalGeral = votosCandidato1 + votosCandidato2 + votosCandidato3;

  const calcularResultado = () => {
    if (totalGeral === 0) {
      return 'Nenhum voto registado ainda.';
    }

    const maxVotos = Math.max(votosCandidato1, votosCandidato2, votosCandidato3);
    let lideres = [];
    if (votosCandidato1 === maxVotos) lideres.push('Candidato A');
    if (votosCandidato2 === maxVotos) lideres.push('Candidato B');
    if (votosCandidato3 === maxVotos) lideres.push('Candidato C');

    if (lideres.length > 1) {
      return `Empate na liderança entre: ${lideres.join(' e ')} com ${maxVotos} votos!`;
    } else {
      if (maxVotos === votosCandidato1) return `Líder atual: Candidato A (${maxVotos} votos)`;
      if (maxVotos === votosCandidato2) return `Líder atual: Candidato B (${maxVotos} votos)`;
      return `Líder atual: Candidato C (${maxVotos} votos)`;
    }
  };

  return (
    <ScrollView contentContainerStyle={styles.container}>
      <Text style={styles.titulo}>Eleição de Representantes</Text>
      <Text style={styles.subtitulo}>Registe o seu voto nos candidatos abaixo:</Text>

      
      <View style={styles.cardCandidato}>
        <Text style={styles.nomeCandidato}>Candidato A</Text>
        <Text style={styles.votosTexto}>Votos: {votosCandidato1}</Text>
        <TouchableOpacity style={[styles.botao, styles.botaoVotar]} onPress={votarCandidato1}>
          <Text style={styles.textoBotao}>Votar em A</Text>
        </TouchableOpacity>
      </View>

      
      <View style={styles.cardCandidato}>
        <Text style={styles.nomeCandidato}>Candidato B</Text>
        <Text style={styles.votosTexto}>Votos: {votosCandidato2}</Text>
        <TouchableOpacity style={[styles.botao, styles.botaoVotar]} onPress={votarCandidato2}>
          <Text style={styles.textoBotao}>Votar em B</Text>
        </TouchableOpacity>
      </View>

      <View style={styles.cardCandidato}>
        <Text style={styles.nomeCandidato}>Candidato C</Text>
        <Text style={styles.votosTexto}>Votos: {votosCandidato3}</Text>
        <TouchableOpacity style={[styles.botao, styles.botaoVotar]} onPress={votarCandidato3}>
          <Text style={styles.textoBotao}>Votar em C</Text>
        </TouchableOpacity>
      </View>
      <View style={styles.resultadoContainer}>
        <Text style={styles.tituloResumo}>Resumo da Votação</Text>
        <Text style={styles.textoResumo}>Total Geral de Votos: <Text style={styles.negrito}>{totalGeral}</Text></Text>
        <Text style={[styles.textoResumo, styles.statusLideranca]}>{calcularResultado()}</Text>
      </View>
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  container: {
    flexGrow: 1,
    justifyContent: 'center',
    padding: 20,
    backgroundColor: '#f5f5f5',
  },
  titulo: {
    fontSize: 22,
    fontWeight: 'bold',
    textAlign: 'center',
    marginBottom: 5,
    color: '#333',
  },
  subtitulo: {
    fontSize: 14,
