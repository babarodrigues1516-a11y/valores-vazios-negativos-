    color: '#666',
  },
  cardCandidato: {
    backgroundColor: '#fff',
    padding: 15,
    borderRadius: 8,
    marginBottom: 15,
    borderWidth: 1,
    borderColor: '#e2e8f0',
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
  },
  nomeCandidato: {
    fontSize: 16,
    fontWeight: 'bold',
    color: '#333',
  },
  votosTexto: {
    fontSize: 14,
    color: '#64748b',
  },
  botao: {
