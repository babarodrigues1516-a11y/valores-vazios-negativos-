import React, { useState } from 'react';
import { 
  View, 
  Text, 
  TextInput, 
  TouchableOpacity, 
  StyleSheet, 
  ScrollView, 
  Alert 
} from 'react-native';

// Lista com pelo menos 4 produtos iniciais
const PRODUTOS_DISPONIVEIS = [
  { id: '1', nome: 'Sanduíche', preco: 8.00 },
  { id: '2', nome: 'Suco', preco: 5.00 },
  { id: '3', nome: 'Pão de Queijo', preco: 4.50 },
  { id: '4', nome: 'Café', preco: 3.50 },
];

export default function App() {
  const [pedido, setPedido] = useState([]);
  const [quantidadeDesejada, setQuantidadeDesejada] = useState('');
  const [produtoSelecionado, setProdutoSelecionado] = useState(null);

  // Adicionar item ao pedido (ou atualizar se já estiver na lista)
  const adicionarItem = () => {
    if (!produtoSelecionado) {
      Alert.alert('Atenção', 'Selecione um produto primeiro.');
      return;
    }

    const qtd = parseInt(quantidadeDesejada, 10);
    if (isNaN(qtd) || qtd <= 0) {
      Alert.alert('Atenção', 'Informe uma quantidade válida maior que zero.');
      return;
    }

    const subtotal = produtoSelecionado.preco * qtd;

    // Verificar se o item já existe no array do pedido
    const indexExistente = pedido.findIndex(item => item.id === produtoSelecionado.id);

    if (indexExistente >= 0) {
      // Atualiza o item existente
      const novoPedido = [...pedido];
      novoPedido[indexExistente].quantidade += qtd;
      novoPedido[indexExistente].subtotal = novoPedido[indexExistente].quantidade * novoPedido[indexExistente].preco;
      setPedido(novoPedido);
    } else {
      // Adiciona novo objeto no array
      const novoItem = {
        id: produtoSelecionado.id,
        nome: produtoSelecionado.nome,
        preco: produtoSelecionado.preco,
        quantidade: qtd,
        subtotal: subtotal,
      };
      setPedido([...pedido, novoItem]);
    }

    // Limpar seleções
    setQuantidadeDesejada('');
    setProdutoSelecionado(null);
  };

  // Remover item do pedido
  const removerItem = (id) => {
    const novoPedido = pedido.filter(item => item.id !== id);
    setPedido(novoPedido);
  };

  // Calcular valor total do pedido
  const calcularTotal = () => {
    return pedido.reduce((soma, item) => soma + item.subtotal, 0);
  };

  return (
    <ScrollView contentContainerStyle={styles.container}>
      <Text style={styles.titulo}>Lanchonete Universitária</Text>

      {/* Seção de Seleção de Produtos */}
      <Text style={styles.subtitulo}>Cardápio:</Text>
      <View style={styles.gradeProdutos}>
        {PRODUTOS_DISPONIVEIS.map(prod => {
          const selecionado = produtoSelecionado?.id === prod.id;
          return (
            <TouchableOpacity
              key={prod.id}
              style={[styles.cardProduto, selecionado && styles.cardSelecionado]}
              onPress={() => setProdutoSelecionado(prod)}
            >
              <Text style={[styles.textoProduto, selecionado && styles.textoSelecionado]}>
                {prod.nome}
              </Text>
              <Text style={[styles.textoPreco, selecionado && styles.textoSelecionado]}>
                R$ {prod.preco.toFixed(2).replace('.', ',')}
              </Text>
            </TouchableOpacity>
          );
        })}
      </View>

      {/* Entrada de Quantidade e Botão Adicionar */}
      <View style={styles.secaoQuantidade}>
        <TextInput
          style={styles.input}
          placeholder="Qtd"
          keyboardType="numeric"
          value={quantidadeDesejada}
          onChangeText={setQuantidadeDesejada}
        />
        <TouchableOpacity style={styles.botaoAdicionar} onPress={adicionarItem}>
          <Text style={styles.textoBotao}>Adicionar ao Pedido</Text>
        </TouchableOpacity>
      </View>

      {/* Resumo Final / Lista do Pedido */}
      <Text style={styles.subtitulo}>Resumo do Pedido:</Text>
      {pedido.length === 0 ? (
        <Text style={styles.vazio}>Nenhum item adicionado ainda.</Text>
      ) : (
        <View style={styles.listaPedido}>
          {pedido.map(item => (
            <View key={item.id} style={styles.itemCarrinho}>
              <View style={{ flex: 1 }}>
                <Text style={styles.itemTexto}>
                  {item.quantidade}x {item.nome} (R$ {item.preco.toFixed(2).replace('.', ',')} un)
                </Text>
                <Text style={styles.itemSubtotal}>
                  Subtotal: R$ {item.subtotal.toFixed(2).replace('.', ',')}
                </Text>
              </View>
              <TouchableOpacity style={styles.botaoRemover} onPress={() => removerItem(item.id)}>
                <Text style={styles.textoRemover}>Remover</Text>
              </TouchableOpacity>
            </View>
          ))}

          <View style={styles.totalContainer}>
            <Text style={styles.totalTexto}>
              Total: R$ {calcularTotal().toFixed(2).replace('.', ',')}
            </Text>
          </View>
        </View>
      )}
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  container: { padding: 20, backgroundColor: '#f8f9fa', flexGrow: 1, justifyContent: 'center' },
  titulo: { fontSize: 22, fontWeight: 'bold', marginBottom: 16, textAlign: 'center', color: '#2b2d42' },
  subtitulo: { fontSize: 16, fontWeight: 'bold', marginTop: 16, marginBottom: 8, color: '#495057' },
  gradeProdutos: { flexDirection: 'row', flexWrap: 'wrap', gap: 10, justifyContent: 'space-between' },
  cardProduto: { width: '48%', backgroundColor: '#fff', padding: 12, borderRadius: 8, borderWidth: 1, borderColor: '#ced4da', alignItems: 'center' },
  cardSelecionado: { backgroundColor: '#3a86ff', borderColor: '#2b6cb0' },
  textoProduto: { fontSize: 15, fontWeight: '600', color: '#333' },
  textoPreco: { fontSize: 14, color: '#666', marginTop: 4 },
  textoSelecionado: { color: '#fff' },
  secaoQuantidade: { flexDirection: 'row', marginTop: 12, gap: 10 },
  input: { width: 70, backgroundColor: '#fff', borderWidth: 1, borderColor: '#ced4da', borderRadius: 8, padding: 10, textAlign: 'center', fontSize: 16 },
  botaoAdicionar: { flex: 1, backgroundColor: '#38b000', borderRadius: 8, justifyContent: 'center', alignItems: 'center' },
  textoBotao: { color: '#fff', fontWeight: 'bold', fontSize: 15 },
  vazio: { fontStyle: 'italic', color: '#6c757d', textAlign: 'center', marginVertical: 10 },
  listaPedido: { marginTop: 8 },
  itemCarrinho: { backgroundColor: '#fff', padding: 12, borderRadius: 8, flexDirection: 'row', alignItems: 'center', marginBottom: 8, borderWidth: 1, borderColor: '#e9ecef' },
  itemTexto: { fontSize: 15, fontWeight: '600', color: '#212529' },
  itemSubtotal: { fontSize: 13, color: '#6c757d', marginTop: 2 },
  botaoRemover: { backgroundColor: '#d90429', paddingVertical: 6, paddingHorizontal: 10, borderRadius: 6 },
  textoRemover: { color: '#fff', fontSize: 12, fontWeight: 'bold' },
  totalContainer: { marginTop: 10, padding: 12, backgroundColor: '#e2eafc', borderRadius: 8, alignItems: 'flex-end' },
  totalTexto: { fontSize: 18, fontWeight: 'bold', color: '#1d3557' },
});
