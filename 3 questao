import React, { useState } from 'react';
import { View, Text, TextInput, TouchableOpacity, StyleSheet, Alert } from 'react-native';

export default function App() {
  const [produto, setProduto] = useState('');
  const [qtdInicial, setQtdInicial] = useState('');
  const [movimentacao, setMovimentacao] = useState('');
  const [estoqueAtual, setEstoqueAtual] = useState(null);

  const definirEstoqueInicial = () => {
    const valor = parseInt(qtdInicial, 10);
    if (!produto.trim() || isNaN(valor) || valor < 0) {
      Alert.alert('Erro', 'Informe o nome do produto e uma quantidade inicial válida.');
      return;
    }
    setEstoqueAtual(valor);
  };

  const adicionarEstoque = () => {
    const valor = parseInt(movimentacao, 10);
    if (isNaN(valor) || valor <= 0) {
      Alert.alert('Erro', 'Informe uma quantidade válida para adicionar.');
      return;
    }
    setEstoqueAtual((prev) => prev + valor);
    setMovimentacao('');
  };

  const retirarEstoque = () => {
    const valor = parseInt(movimentacao, 10);
    if (isNaN(valor) || valor <= 0) {
      Alert.alert('Erro', 'Informe uma quantidade válida para retirar.');
      return;
    }
    if (valor > estoqueAtual) {
      Alert.alert('Operação bloqueada', 'A retirada não pode ser superior ao estoque disponível.');
      return;
    }
    setEstoqueAtual((prev) => prev - valor);
    setMovimentacao('');
  };

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Controle de Estoque</Text>

      {estoqueAtual === null ? (
        <View>
          <TextInput
            style={styles.input}
            placeholder="Nome do produto"
            value={produto}
            onChangeText={setProduto}
          />
          <TextInput
            style={styles.input}
            placeholder="Quantidade inicial"
            keyboardType="numeric"
            value={qtdInicial}
            onChangeText={setQtdInicial}
          />
          <TouchableOpacity style={styles.botaoPrincipal} onPress={definirEstoqueInicial}>
            <Text style={styles.textoBotao}>Iniciar Controle</Text>
          </TouchableOpacity>
        </View>
      ) : (
        <View>
          <View style={styles.painel}>
            <Text style={styles.nomeProduto}>{produto}</Text>
            <Text style={styles.quantidade}>Disponível: {estoqueAtual} unidades</Text>

            {estoqueAtual < 5 && (
              <Text style={styles.alerta}>
                ⚠️ Alerta: Estoque baixo (menos de 5 unidades)!
              </Text>
            )}
          </View>

          <TextInput
            style={styles.input}
            placeholder="Quantidade da movimentação"
            keyboardType="numeric"
            value={movimentacao}
            onChangeText={setMovimentacao}
          />

          <View style={styles.linhaBotoes}>
            <TouchableOpacity style={[styles.botaoAcao, styles.adicionar]} onPress={adicionarEstoque}>
              <Text style={styles.textoBotao}>Adicionar estoque</Text>
            </TouchableOpacity>

            <TouchableOpacity style={[styles.botaoAcao, styles.retirar]} onPress={retirarEstoque}>
              <Text style={styles.textoBotao}>Retirar estoque</Text>
            </TouchableOpacity>
          </View>
        </View>
      )}
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, justifyContent: 'center', padding: 24, backgroundColor: '#f4f4f9' },
  titulo: { fontSize: 22, fontWeight: 'bold', marginBottom: 20, textAlign: 'center' },
  input: { backgroundColor: '#fff', borderWidth: 1, borderColor: '#ccc', borderRadius: 8, padding: 12, marginBottom: 14, fontSize: 16 },
  botaoPrincipal: { backgroundColor: '#2b2d42', padding: 14, borderRadius: 8, alignItems: 'center' },
  painel: { backgroundColor: '#fff', padding: 18, borderRadius: 8, marginBottom: 16, borderWidth: 1, borderColor: '#ddd' },
  nomeProduto: { fontSize: 18, fontWeight: 'bold', marginBottom: 6 },
  quantidade: { fontSize: 16, color: '#333' },
  alerta: { marginTop: 10, color: '#d90429', fontWeight: 'bold', fontSize: 14 },
  linhaBotoes: { flexDirection: 'row', justifyContent: 'space-between', gap: 10 },
  botaoAcao: { flex: 1, padding: 14, borderRadius: 8, alignItems: 'center' },
  adicionar: { backgroundColor: '#2a9d8f' },
  retirar: { backgroundColor: '#e76f51' },
  textoBotao: { color: '#fff', fontWeight: 'bold', fontSize: 14, textAlign: 'center' },
});
